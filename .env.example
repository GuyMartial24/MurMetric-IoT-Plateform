# Copier ce fichier en .env et renseigner les vraies valeurs.
# .env est dans .gitignore — ne jamais committer les vraies valeurs.
#
# Toutes les variables ci-dessous sont OBLIGATOIRES pour docker-compose.yml
# (03/08/2026) — docker compose refusera de démarrer si l'une d'elles est
# vide, plutôt que de retomber silencieusement sur une valeur par défaut
# faible/devinable.

# Token API InfluxDB (admin token généré au premier démarrage du conteneur
# influxdb, ou fixé à l'avance ici pour qu'il soit stable entre redéploiements).
# Générer une valeur aléatoire, ex. : openssl rand -hex 32
INFLUX_TOKEN=

# Mot de passe du compte admin InfluxDB (utilisateur : admin).
INFLUX_PASSWORD=

# Nom du bucket InfluxDB.
INFLUX_BUCKET=Capteurs

# Identifiant tenant — namespace des topics Kafka (murmetric.{tenant}.*).
TENANT_ID=frd

# Mot de passe du compte admin Grafana (utilisateur : admin).
GRAFANA_ADMIN_PASSWORD=

# Identifiants du broker MQTT (Mosquitto, allow_anonymous désactivé depuis le
# 03/08/2026 — cf. logique_projet.md). Après avoir renseigné ces deux valeurs,
# exécuter ./generer_mosquitto_password.sh une fois avant le premier
# `docker compose up` (et à nouveau si le mot de passe change). Ces mêmes
# identifiants doivent aussi être configurés sur le PC labo Windows (Amiens)
# et le Raspberry Pi (Amiens), dans LEUR PROPRE environnement local — ce
# ne sont pas des machines couvertes par ce .env du VPS.
MQTT_USERNAME=
MQTT_PASSWORD=

# TLS côté client (04/08/2026) — PAS une variable de ce .env (le bridge, sur
# le VPS, parle à mosquitto en clair via le réseau interne docker-compose/k8s
# et n'a pas besoin de TLS). Concerne uniquement le PC labo Windows (Amiens)
# et le Raspberry Pi (Amiens) quand ils se connectent au broker Kubernetes
# distant sur le port 8883 : dans LEUR environnement local, définir
# MQTT_TLS_ENABLED=true et MQTT_CA_CERT=<chemin vers le certificat auto-signé
# fourni séparément> — cf. logique_projet.md.
