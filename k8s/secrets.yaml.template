# Template de secrets MurMetric — NE PAS COMMITTER avec de vraies valeurs.
# Copier ce fichier en secrets.yaml, remplir les valeurs encodées en base64 :
#   echo -n "ma_valeur_secrete" | base64
# Puis appliquer : kubectl apply -f k8s/secrets.yaml
#
# secrets.yaml est dans .gitignore — ne jamais versionner les vrais secrets.

apiVersion: v1
kind: Secret
metadata:
  name: murmetric-secrets
  namespace: murmetric
type: Opaque
data:
  # echo -n "password_frd_test" | base64
  influx-password: <BASE64_INFLUX_PASSWORD>
  # echo -n "MON_TOKEN_INFLUXDB" | base64
  influx-token: <BASE64_INFLUX_TOKEN>
  # echo -n "mot_de_passe_admin_grafana" | base64
  grafana-admin-password: <BASE64_GRAFANA_ADMIN_PASSWORD>
  # Identifiants MQTT (bridge-mqtt-kafka + clients distants PC Amiens/RPi).
  # echo -n "mon_utilisateur_mqtt" | base64
  mqtt-username: <BASE64_MQTT_USERNAME>
  # echo -n "mon_mot_de_passe_mqtt" | base64
  mqtt-password: <BASE64_MQTT_PASSWORD>
  # Contenu du fichier de mots de passe Mosquitto (hash bcrypt, PAS le mot de
  # passe en clair), généré via generer_mosquitto_password.sh puis :
  #   base64 -w0 mosquitto_password.txt
  mosquitto-password-file: <BASE64_MOSQUITTO_PASSWORD_FILE_CONTENT>
  # Mot de passe du superuser TimescaleDB (chantier migration, section 32,
  # 17/08/2026) — généré aléatoirement, pas de valeur humaine à retenir.
  # echo -n "mot_de_passe_genere" | base64
  timescaledb-password: <BASE64_TIMESCALEDB_PASSWORD>
